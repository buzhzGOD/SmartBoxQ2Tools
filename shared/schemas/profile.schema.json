{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smartboxq2.local/schema/profile-v1.json",
  "title": "Smart Box Q2 Cleaner Profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "profileId", "targetConstraints", "operation", "userId", "packages"],
  "properties": {
    "schemaVersion": {"const": 1},
    "profileId": {"type": "string", "minLength": 1},
    "name": {"type": "string"},
    "description": {"type": "string"},
    "targetConstraints": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": ["string", "integer"]},
      "properties": {
        "fingerprint": {"type": "string", "minLength": 1},
        "apiLevel": {"type": ["string", "integer"]},
        "manufacturer": {"type": "string"},
        "model": {"type": "string"}
      }
    },
    "operation": {"const": "disable-user"},
    "userId": {"const": 0},
    "packages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["package", "rationale", "riskLevel"],
        "properties": {
          "package": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*(?:\\.[A-Za-z][A-Za-z0-9_]*)+$"},
          "rationale": {"type": "string", "minLength": 1},
          "riskLevel": {"enum": ["low", "medium"]}
        }
      }
    }
  }
}
